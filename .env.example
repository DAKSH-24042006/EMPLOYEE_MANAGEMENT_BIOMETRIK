# ==============================================================================
# BIOMETRIK SYSTEMS EMPLOYEE MANAGEMENT & PROJECT WORKSPACE ENVIRONMENT CONFIG
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CORE
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://requirement.biometrik.org
APP_URL=https://requirement.biometrik.org

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Self-hosted or MongoDB Atlas Cluster)
MONGODB_URI=mongodb://localhost:27017/requirement_dashboard
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/biometrik_workspace?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Strong random 32+ character key for signing stateless session JWT tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key

# ------------------------------------------------------------------------------
# 4. OUTBOUND SMTP EMAIL NOTIFICATION ENGINE
# ------------------------------------------------------------------------------
# Outbound SMTP credentials for dispatching task assignments, deadline reminders, and overdue notices
#EMAIL CONFIGURATION
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=alerts@biometrik.in
EMAIL_PASS=Noventiq@2026
EMAIL_FROM=alerts@biometrik.in
DEVOPS_EMAIL_ADDRESSES=kiran.miskin@biometrik.in

# ------------------------------------------------------------------------------
# 5. AUTOMATED CRON & DEADLINE REMINDER ENGINE
# ------------------------------------------------------------------------------
# Secret token used by system crontab, Cloud Scheduler, or cron runner
# Trigger Endpoint: GET /api/cron/check-reminders?token=YOUR_CRON_SECRET
CRON_SECRET=replace_with_a_strong_random_cron_secret_token

# ------------------------------------------------------------------------------
# 6. GOOGLE CALENDAR SYNC (OPTIONAL)
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_REDIRECT_URI=https://workspace.yourdomain.com/api/auth/google/callback
