#!/usr/bin/env sh
# ─── Husky Pre-Push Hook ────────────────────────────────────────────────────
# Runs the full test suite before pushing to remote.
# This prevents broken code from being pushed to the repository.
# ─────────────────────────────────────────────────────────────────────────────
echo "🧪 Running tests before push..."
npm run test:ci

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Tests failed. Push aborted. Fix the tests before pushing."
  exit 1
fi

echo "✅ All tests passed. Pushing to remote..."
